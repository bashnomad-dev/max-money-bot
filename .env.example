# === MAX Bot API ===
MAX_BOT_TOKEN=

# === LLM (российский стек) ===
GIGACHAT_CREDENTIALS=               # Authorization key из личного кабинета GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS    # GIGACHAT_API_PERS / GIGACHAT_API_B2B / GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-Max         # GigaChat / GigaChat-Pro / GigaChat-Max
GIGACHAT_VERIFY_SSL=false           # для self-signed сертификатов Сбера
GIGACHAT_TIMEOUT_SEC=30
LLM_BACKEND=gigachat                # gigachat | openrouter | claude
LLM_BACKEND_FALLBACK=               # gigachat / openrouter / claude или пусто

# === OpenRouter (единый OpenAI-совместимый API к Claude/GPT/Gemini) ===
OPENROUTER_API_KEY=                 # ключ с openrouter.ai
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SEC=30

# === STT ===
STT_ENGINE=gigaam                   # gigaam (локально, бесплатно) | whisper (API, fallback)
STT_FALLBACK=                       # запасной движок если основной упал/вернул пусто: whisper | gigaam | пусто
GIGAAM_MODEL=v2_rnnt                # v2_rnnt / v2_ctc / v1_ctc
OPENAI_API_KEY=                     # только для whisper fallback и опц. embeddings
ANTHROPIC_API_KEY=                  # только для claude fallback

# === Google Sheets ===
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
DEFAULT_SHEET_ID=
ENABLE_PROCESSING_LOG_SHEET=false

# === Доступ ===
ALLOWED_USER_IDS=                   # через запятую
SILENT_REJECT=false
OPS_PIN=                            # PIN для /undo, /edit
PIN_MAX_ATTEMPTS=3
PIN_LOCKOUT_MINUTES=10

# === Поведение ===
TZ=Europe/Moscow
LOG_LEVEL=INFO
DB_PATH=./data/bot.sqlite3
DEFAULT_LOCATION=                   # дефолтная точка если в голосе не упомянута («Магазин Зинино»)

# === Отчёты ===
DAILY_REPORT_TIME=21:00
DAILY_REPORT_MAX_RETRIES=5
DAILY_REPORT_ENABLED=true            # false → не слать дневной автоотчёт (на тест-неделю выключено)

# === Режим «записная книжка» (упрощение под тест-неделю) ===
ENABLE_STOCK_TRACKING=true                  # false → не считать остатки, без предупреждений о минусе, лист «Остатки» не трогать
ENFORCE_PRODUCT_CANONICALIZATION=true       # false → товар пишется как надиктовано, без сверки с каталогом (канонизация точек остаётся)

# === Гибридный UX ===
AUTO_WRITE_CONFIDENCE_THRESHOLD=0.85
CLARIFICATION_THRESHOLD=0.5
LARGE_AMOUNT_THRESHOLD_RUB=150000   # у Евгения B2B-отгрузки на миллионы — порог поднят

# === Канонизация ===
CANON_SIMILARITY_THRESHOLD=0.8
PRODUCTS_IMPORT_PATH=./data/products-import.json   # путь к нормализованному прайсу для setup

# === Дедуп/диалоги ===
DEDUP_WINDOW_MINUTES=5
DIALOG_STATE_TTL_MINUTES=5

# === Голос ===
VOICE_MAX_DURATION_SEC=120
ENABLE_NOISE_REDUCTION=false

# === Бюджет ===
MONTHLY_API_BUDGET_RUB=0            # 0 = без лимита; в рублях, не USD (российский стек)
