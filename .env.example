# === Внешние API ===
MAX_BOT_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json

# === Sheets ===
DEFAULT_SHEET_ID=
ENABLE_PROCESSING_LOG_SHEET=false
SHEETS_SCHEMA_VERSION=v2.0

# === Доступ ===
ALLOWED_USER_IDS=
SILENT_REJECT=false
OPS_PIN=
PIN_MAX_ATTEMPTS=3
PIN_LOCKOUT_MINUTES=10

# === Поведение ===
LOG_LEVEL=INFO
DB_PATH=./data/bot.sqlite3
TZ=Europe/Moscow
DEFAULT_LOCATION=

# === Отчёты ===
DAILY_REPORT_TIME=21:00
DAILY_REPORT_MAX_RETRIES=5

# === Гибридный UX (SPEC §9) ===
AUTO_WRITE_CONFIDENCE_THRESHOLD=0.85
CLARIFICATION_THRESHOLD=0.5
LARGE_AMOUNT_THRESHOLD_RUB=100000

# === Дедупликация и диалоги ===
DEDUP_WINDOW_MINUTES=5
DIALOG_STATE_TTL_MINUTES=5

# === Голос ===
VOICE_MAX_DURATION_SEC=60
ENABLE_NOISE_REDUCTION=false

# === Канонизация ===
CANON_SIMILARITY_THRESHOLD=0.8

# === Остатки и инвентаризация ===
LOW_STOCK_THRESHOLD_DEFAULT=0

# === Бюджет (0 = без лимита) ===
MONTHLY_API_BUDGET_USD=0
